{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lezjo.github.io/adriatic-new-build-radar/schema/v3.1.json",
  "title": "Adriatic New Build Radar — Canonical Data Schema",
  "description": "Canonical V3.1 data contract for Source → SourceRun → RawCapture → Observation → Listing → Unit → Project → PriceObservation / Promotion → Analysis → UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "generated_at",
    "sources",
    "source_runs",
    "raw_captures",
    "observations",
    "projects",
    "units",
    "listings",
    "price_observations",
    "promotions",
    "locations",
    "micro_locations",
    "audit_results"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.1.0"
    },
    "schema_name": {
      "type": "string",
      "const": "adriatic-new-build-radar-canonical"
    },
    "generated_at": {
      "$ref": "#/$defs/dateTime"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "source_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceRun"
      }
    },
    "raw_captures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RawCapture"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Observation"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Project"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Unit"
      }
    },
    "listings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Listing"
      }
    },
    "price_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PriceObservation"
      }
    },
    "promotions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Promotion"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Location"
      }
    },
    "micro_locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MicroLocation"
      }
    },
    "audit_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuditResult"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR"
      ]
    },
    "Coordinates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
