        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_capture_id": {
          "type": [
            "string",
